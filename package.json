{
  "name": "topova-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "npm run build -w @nettopo/backend && node scripts/run.mjs build frontend",
    "start": "node scripts/run.mjs start",
    "lint": "eslint frontend/src backend/src backend/lib shared/lib tests --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema backend/prisma/schema.prisma",
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma",
    "dev:frontend": "node scripts/run.mjs dev frontend",
    "dev:backend": "node scripts/run.mjs dev backend",
    "db:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "test:e2e": "playwright test",
    "test:db": "vitest run tests/branch-revisions.integration.test.ts",
    "db:import-local": "tsx scripts/migrate-local-store.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:production",
    "test:production": "tsx scripts/smoke-production.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.0",
    "prettier": "^3.10.1",
    "prisma": "^5.20.0",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "type": "module"
}
