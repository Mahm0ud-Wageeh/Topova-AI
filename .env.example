# Development works offline. Production requires PostgreSQL and a dedicated 32+ character JWT_SECRET.
NETTOPO_STORAGE=local-json
# NETTOPO_STORE_PATH=/absolute/path/to/store.json
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
FRONTEND_PORT=3000
APP_URL=http://localhost:3000
NETTOPO_AUTHORIZED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=
DATABASE_URL=postgresql://nettopo:change-me@127.0.0.1:5432/nettopo
DIRECT_URL=postgresql://nettopo:change-me@127.0.0.1:5432/nettopo
# NETTOPO_TEST_DATABASE_URL=postgresql://nettopo:change-me@127.0.0.1:5432/nettopo_test

# Optional external conversation engine. Attached configs and profile context are sent to it when enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional topology parsing providers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
Z_API_KEY=
ZAI_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3
