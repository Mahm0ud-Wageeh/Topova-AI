generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  name      String?
  projects  Project[]
  createdAt DateTime  @default(now())
}

// Versioned branch designs are scoped directly to the authenticated subject.
// They are separate from the legacy topology generator's projects.
model BranchDesign {
  id          String                 @id @default(cuid())
  ownerId     String
  name        String
  head        Int                    @default(1)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  revisions   BranchDesignRevision[]

  @@index([ownerId, updatedAt])
}

model BranchDesignRevision {
  designId  String
  number    Int
  plan      Json
  createdAt DateTime     @default(now())
  design    BranchDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@id([designId, number])
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  source      InputType    @default(MANUAL)
  prompt      String?
  topology    Topology?
  plan        NetworkPlan?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId, updatedAt])
}

model Topology {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String       @unique
  devices     Device[]
  connections Connection[]
  layout      Json?
}

model Device {
  id         String       @id @default(cuid())
  topology   Topology     @relation(fields: [topologyId], references: [id], onDelete: Cascade)
  topologyId String
  label      String
  type       DeviceType
  meta       Json?
  fromLinks  Connection[] @relation("from")
  toLinks    Connection[] @relation("to")

  @@index([topologyId])
}

model Connection {
  id         String   @id @default(cuid())
  topology   Topology @relation(fields: [topologyId], references: [id], onDelete: Cascade)
  topologyId String
  from       Device   @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  fromId     String
  to         Device   @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  toId       String
  meta       Json?

  @@index([topologyId])
}

model NetworkPlan {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @unique
  ipPlan    Json
  vlanPlan  Json
  routing   Json
  notes     Json?
}

enum InputType {
  PROMPT
  MANUAL
}

enum DeviceType {
  ROUTER
  SWITCH
  SERVER
  PC
  FIREWALL
  AP
  PRINTER
  CAMERA
  NVR
  IP_PHONE
}

// Active platform persistence. Legacy relational tables are retained for explicit migration.
model PlatformUser {
  id String @id
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
}

model PlatformRecord {
  kind String
  id String
  ownerId String
  payload Json
  updatedAt DateTime @updatedAt
  @@id([kind, id])
  @@index([ownerId, kind, updatedAt])
}
