{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/lib/utils": [
        "frontend/src/lib/utils.ts"
      ],
      "@/lib/*": [
        "shared/lib/*"
      ],
      "@/Docs/*": [
        "Docs/*"
      ],
      "@/*": [
        "frontend/src/*"
      ],
      "@server/*": [
        "backend/lib/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "frontend/vite.config.ts",
    "backend/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "scripts/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend/dist",
    "backend/generated"
  ]
}
